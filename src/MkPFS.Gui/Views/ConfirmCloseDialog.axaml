<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:MkPFS.Gui.Localization"
        x:Class="MkPFS.Gui.Views.ConfirmCloseDialog"
        Title="{l:Tr close_title}" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20" Spacing="18">
    <TextBlock Text="{l:Tr close_message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="KeepButton" Content="{l:Tr close_keep}" Click="OnKeep" IsDefault="True" IsCancel="True" MinWidth="120" />
      <Button Name="StopButton" Content="{l:Tr close_stop}" Click="OnStop" Classes="run" Background="{StaticResource Error}" MinWidth="120" />
    </StackPanel>
  </StackPanel>
</Window>
