<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MkPFS.Gui.ViewModels"
             xmlns:v="using:MkPFS.Gui.Views"
             xmlns:c="using:MkPFS.Gui.Controls"
             xmlns:l="using:MkPFS.Gui.Localization"
             x:Class="MkPFS.Gui.Views.Panels.UnpackForm"
             x:DataType="vm:UnpackPanelViewModel">
  <StackPanel Classes="form">
    <TextBlock Text="{l:Tr meta_import}" Classes="section" Foreground="{Binding Accent}" />
    <v:MetadataPreview DataContext="{Binding Metadata}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr paths}" Classes="section" Foreground="{Binding Accent}" />
    <c:PathField Label="{l:Tr u_image_label}" Placeholder="{l:Tr u_image_ph}" Mode="Open" Filters="PFS image:*.ffpfs *.ffpfsc|All files:*.*" Text="{Binding Image}" />
    <c:PathField Label="{l:Tr u_out_label}" Placeholder="{l:Tr u_out_ph}" Mode="Folder" Text="{Binding Output}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr options}" Classes="section" Foreground="{Binding Accent}" />
    <CheckBox Content="{l:Tr u_overwrite}" IsChecked="{Binding Overwrite}" />
    <Grid ColumnDefinitions="*,12,*">
      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Text="{l:Tr u_ekpfs}" Classes="fieldlabel" />
        <TextBox Text="{Binding Ekpfs}" PlaceholderText="{l:Tr u_ekpfs_ph}" Classes="mono" />
      </StackPanel>
      <CheckBox Grid.Column="2" Content="{l:Tr u_newcrypt}" IsChecked="{Binding NewCrypt}" VerticalAlignment="Bottom" />
    </Grid>
  </StackPanel>
</UserControl>
