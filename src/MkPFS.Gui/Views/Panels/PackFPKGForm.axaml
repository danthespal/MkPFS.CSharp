<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MkPFS.Gui.ViewModels"
             xmlns:v="using:MkPFS.Gui.Views"
             xmlns:c="using:MkPFS.Gui.Controls"
             xmlns:l="using:MkPFS.Gui.Localization"
             x:Class="MkPFS.Gui.Views.Panels.PackFPKGForm"
             x:DataType="vm:PackFPKGPanelViewModel">
  <StackPanel Classes="form">
    <Border BorderBrush="{StaticResource Warning}" BorderThickness="1" CornerRadius="4" Padding="10,8">
      <TextBlock Name="FirmwareNote" Text="{l:Tr fpk_firmware}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" />
    </Border>
    <TextBlock Text="{l:Tr meta_import}" Classes="section" Foreground="{Binding Accent}" />
    <v:MetadataPreview DataContext="{Binding Metadata}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr paths}" Classes="section" Foreground="{Binding Accent}" />
    <c:PathField Label="{l:Tr fpk_src_label}" Placeholder="{l:Tr fpk_src_ph}" Mode="Folder" Text="{Binding Source}" />
    <c:PathField Label="{l:Tr fpk_out_label}" Placeholder="{l:Tr fpk_out_ph}" Mode="Save" Filters="PS5 package:*.pkg" Text="{Binding Output}" />
    <c:PathField Label="{l:Tr pkf_temp}" Placeholder="{l:Tr fpk_temp_ph}" Mode="Folder" Text="{Binding TempFolder}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr options}" Classes="section" Foreground="{Binding Accent}" />
    <Grid ColumnDefinitions="2*,12,*,12,*">
      <StackPanel Grid.Column="0" Spacing="3" ToolTip.Tip="{l:Tr tip_fpk_content_id}">
        <TextBlock Text="{l:Tr fpk_content_id}" Classes="fieldlabel" />
        <TextBox Name="ContentIdBox" Text="{Binding ContentId}" PlaceholderText="{l:Tr fpk_content_id_ph}" Classes="mono" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="3" ToolTip.Tip="{l:Tr tip_fpk_compression}">
        <TextBlock Text="{l:Tr fpk_compression}" Classes="fieldlabel" />
        <ComboBox Name="CompressionPicker" ItemsSource="{Binding Compressions}" SelectedItem="{Binding Compression}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="4" Spacing="3" ToolTip.Tip="{l:Tr tip_ct_cpu}">
        <TextBlock Text="{l:Tr ct_cpu}" Classes="fieldlabel" />
        <ComboBox Name="CpuPicker" ItemsSource="{Binding CpuChoices}" SelectedItem="{Binding CpuChoice}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Grid>
    <StackPanel Spacing="3" ToolTip.Tip="{l:Tr tip_fpk_passcode}">
      <TextBlock Text="{l:Tr fpk_passcode}" Classes="fieldlabel" />
      <TextBox Text="{Binding Passcode}" PlaceholderText="{l:Tr fpk_passcode_ph}" Classes="mono" />
    </StackPanel>
    <CheckBox Content="{l:Tr fpk_verify}" ToolTip.Tip="{l:Tr tip_fpk_verify}" IsChecked="{Binding VerifyAfter}" />
    <CheckBox Content="{l:Tr fpk_dry_run}" ToolTip.Tip="{l:Tr tip_fpk_dry_run}" IsChecked="{Binding DryRun}" />
    <Rectangle Classes="separator" />
    <Expander Name="AdvancedExpander" Header="{l:Tr adv_title}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="8">
        <CheckBox Content="{l:Tr fpk_no_fake_sign}" ToolTip.Tip="{l:Tr tip_fpk_no_fake_sign}" IsChecked="{Binding NoFakeSign}" />
        <CheckBox Content="{l:Tr adv_verbose}" ToolTip.Tip="{l:Tr tip_adv_verbose}" IsChecked="{Binding Verbose}" />
        <StackPanel Spacing="3" ToolTip.Tip="{l:Tr tip_fpk_seed}">
          <TextBlock Text="{l:Tr fpk_seed}" Classes="fieldlabel" />
          <TextBox Text="{Binding Seed}" PlaceholderText="{l:Tr fpk_seed_ph}" Classes="mono" />
        </StackPanel>
        <TextBlock Text="{l:Tr fpk_generated}" Classes="fieldlabel" />
        <Grid ColumnDefinitions="2*,12,*,12,*">
          <TextBox Grid.Column="0" Text="{Binding AppTitle}" PlaceholderText="{l:Tr fpk_title_ph}" ToolTip.Tip="{l:Tr tip_fpk_generated}" />
          <TextBox Grid.Column="2" Text="{Binding AppVersion}" PlaceholderText="01.00" ToolTip.Tip="{l:Tr tip_fpk_generated}" />
          <ComboBox Grid.Column="4" ItemsSource="{Binding DrmTypes}" SelectedItem="{Binding DrmType}" HorizontalAlignment="Stretch" ToolTip.Tip="{l:Tr tip_fpk_generated}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:Choice"><TextBlock Text="{Binding Label}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
