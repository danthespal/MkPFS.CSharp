<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MkPFS.Gui.ViewModels"
             xmlns:v="using:MkPFS.Gui.Views"
             xmlns:c="using:MkPFS.Gui.Controls"
             xmlns:l="using:MkPFS.Gui.Localization"
             x:Class="MkPFS.Gui.Views.Panels.BatchForm"
             x:DataType="vm:BatchPanelViewModel">
  <StackPanel Classes="form">
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="{Binding Queue.Summary}" Classes="muted" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,6" />
      <TextBlock Text="{l:Tr bt_queue}" Classes="section" Foreground="{Binding Accent}" />
    </DockPanel>
    <v:BatchQueue DataContext="{Binding Queue}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr paths}" Classes="section" Foreground="{Binding Accent}" />
    <c:PathField Label="{l:Tr bt_src_label}" Placeholder="{l:Tr bt_src_ph}" Mode="Folder" Text="{Binding Source}" />
    <c:PathField Label="{l:Tr bt_out_label}" Placeholder="{l:Tr bt_out_ph}" Mode="Folder" Text="{Binding Output}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr options}" Classes="section" Foreground="{Binding Accent}" />
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
      <CheckBox Grid.Row="0" Grid.Column="0" Content="{l:Tr bt_compress}" IsChecked="{Binding Compress}" />
      <CheckBox Grid.Row="1" Grid.Column="0" Content="{l:Tr bt_overwrite}" IsChecked="{Binding Overwrite}" />
      <CheckBox Grid.Row="0" Grid.Column="1" Content="{l:Tr bt_dry}" IsChecked="{Binding DryRun}" />
      <CheckBox Grid.Row="1" Grid.Column="1" Content="{l:Tr pf_verify}" IsChecked="{Binding VerifyAfter}" />
    </Grid>
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr ct_title}" Classes="section" Foreground="{Binding Accent}" />
    <v:CompressionSettings DataContext="{Binding Compression}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr am_section}" Classes="section" Foreground="{Binding Accent}" />
    <v:AmprSettings DataContext="{Binding Ampr}" />
    <Rectangle Classes="separator" />
    <Expander Name="AdvancedExpander" Header="{l:Tr adv_title}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="8">
        <v:PFSOptions DataContext="{Binding PFS}" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
