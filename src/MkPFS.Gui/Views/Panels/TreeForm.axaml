<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MkPFS.Gui.ViewModels"
             xmlns:v="using:MkPFS.Gui.Views"
             xmlns:c="using:MkPFS.Gui.Controls"
             xmlns:l="using:MkPFS.Gui.Localization"
             x:Class="MkPFS.Gui.Views.Panels.TreeForm"
             x:DataType="vm:TreePanelViewModel">
  <StackPanel Classes="form">
    <TextBlock Text="{l:Tr meta_import}" Classes="section" Foreground="{Binding Accent}" />
    <v:MetadataPreview DataContext="{Binding Metadata}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr paths}" Classes="section" Foreground="{Binding Accent}" />
    <c:PathField Label="{l:Tr t_image_label}" Placeholder="{l:Tr t_image_ph}" Mode="Any" Filters="{x:Static vm:TreePanelViewModel.ImageFilters}" Text="{Binding Image}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr encryption}" Classes="section" Foreground="{Binding Accent}" />
    <TextBlock Text="{l:Tr t_ekpfs}" Classes="fieldlabel" />
    <TextBox Text="{Binding Ekpfs}" PlaceholderText="{l:Tr t_ekpfs_ph}" Classes="mono" />
    <CheckBox Content="{l:Tr t_newcrypt}" IsChecked="{Binding NewCrypt}" />
  </StackPanel>
</UserControl>
