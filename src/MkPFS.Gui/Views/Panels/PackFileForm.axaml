<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MkPFS.Gui.ViewModels"
             xmlns:v="using:MkPFS.Gui.Views"
             xmlns:c="using:MkPFS.Gui.Controls"
             xmlns:l="using:MkPFS.Gui.Localization"
             x:Class="MkPFS.Gui.Views.Panels.PackFileForm"
             x:DataType="vm:PackFilePanelViewModel">
  <StackPanel Classes="form">
    <TextBlock Text="{l:Tr meta_import}" Classes="section" Foreground="{Binding Accent}" />
    <v:MetadataPreview DataContext="{Binding Metadata}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr paths}" Classes="section" Foreground="{Binding Accent}" />
    <c:PathField Label="{l:Tr pkf_src_label}" Placeholder="{l:Tr pkf_src_ph}" Mode="Open" Filters="{x:Static vm:PackFilePanelViewModel.SourceFilters}" Text="{Binding Source}" />
    <c:PathField Label="{l:Tr pkf_out_label}" Placeholder="{l:Tr pkf_out_ph}" Mode="Save" Filters="PFS image:*.ffpfsc|All files:*.*" Text="{Binding Output}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr options}" Classes="section" Foreground="{Binding Accent}" />
    <CheckBox Content="{l:Tr pkf_compress}" IsChecked="{Binding Compress}" />
    <c:PathField Label="{l:Tr pkf_temp}" Placeholder="{l:Tr pkf_temp_ph}" Mode="Folder" Text="{Binding TempFolder}" />
    <Rectangle Classes="separator" />
    <TextBlock Text="{l:Tr ct_title}" Classes="section" Foreground="{Binding Accent}" />
    <v:CompressionSettings DataContext="{Binding Compression}" />
    <Rectangle Classes="separator" />
    <Expander Name="AdvancedExpander" Header="{l:Tr adv_title}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <CheckBox Grid.Row="0" Grid.Column="0" Content="{l:Tr pf_signed}" IsChecked="{Binding Signed}" />
          <CheckBox Grid.Row="0" Grid.Column="1" Content="{l:Tr pf_dry}" IsChecked="{Binding DryRun}" />
          <CheckBox Grid.Row="1" Grid.Column="0" Content="{l:Tr pf_verify}" IsChecked="{Binding VerifyAfter}" />
          <CheckBox Grid.Row="1" Grid.Column="1" Content="{l:Tr adv_skip_check}" IsChecked="{Binding SkipVerification}" IsEnabled="{Binding !VerifyAfter}" />
          <CheckBox Grid.Row="2" Grid.Column="0" Content="{l:Tr adv_keep_ext}" IsChecked="{Binding KeepExtension}" />
          <CheckBox Grid.Row="2" Grid.Column="1" Content="{l:Tr adv_keep_inner}" IsChecked="{Binding KeepInnerName}" />
          <CheckBox Grid.Row="3" Grid.Column="0" Content="{l:Tr adv_spool}" IsChecked="{Binding UseSpool}" />
        </Grid>
        <v:PFSOptions DataContext="{Binding PFS}" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
